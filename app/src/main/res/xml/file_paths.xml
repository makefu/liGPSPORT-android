<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider roots. Only the downloaded-activity directory is
     exposed — `getExternalFilesDir(null)/activities/`, which is where
     UploadPipeline.saveActivityFit writes FIT files. Nothing else in
     the app's storage is shareable. -->
<paths>
    <external-files-path name="activities" path="activities/" />
</paths>
